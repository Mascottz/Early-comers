{
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/qr.svg", "destination": "/api/qr" },
    { "source": "/invite", "destination": "/invite.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
